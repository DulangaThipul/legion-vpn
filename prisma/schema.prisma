generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model User {
  id               String    @id @default(auto()) @map("_id") @db.ObjectId
  email            String    @unique
  name             String
  image            String?
  googleImage      String?
  
  
  lastSeen         DateTime  @default(now()) 
  alertMessage     String?   
  hiddenPackages   String[]  
  pastNames        String[]  

  vpns             VpnConfig[] 

  vpnStatus        String    @default("Inactive")
  expiryDate       DateTime?
  vpnConfigKey     String?
  subscriptionLink String?

  reviews          Review[]
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

model VpnConfig {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  userId     String   @db.ObjectId
  user       User     @relation(fields: [userId], references: [id])
  
  name       String   // උදා: "Dialog Router VPN", "Airtel Mobile VPN"
  configKey  String   // VLESS Code එක
  usageLink  String?  // Link එක
  status     String   @default("Active") // "Active" or "Expired"
  
  createdAt  DateTime @default(now())
}

model Review {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId
  user      User     @relation(fields: [userId], references: [id])
  rating    Int
  text      String
  createdAt DateTime @default(now())
}
